{
  "name": "@power-eagle/agent",
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=16.17"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "example": "node examples/run.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "^5.0.2",
    "@types/node": "^24.3.2",
    "vitest": "^3.2.4",
    "@types/react": "^18.2.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
